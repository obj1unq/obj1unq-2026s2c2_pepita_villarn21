import pepita.*
describe "pepita" {
  test "pepita no esta cansada" {
    pepita.energia(100)
    assert.notThat(pepita.estaCansada())
  }
}
describe "pepon" {
  test "pepon no esta cansado" {
    pepon.energia(100)
    assert.notThat(pepon.estaCansado())
  }
}






describe "pepita energia" {
  test "no puede volar" {
    assert.throwsException({pepita.volar(1000)})
}
}
describe "pepon alimento" {
  test "no puede repetir" {
    assert.throwsException({pepon.comer(manzana)})
  }
}